# Configuration César
# Ces identifiants sont à remplacer par les vôtres
CESAR_USERNAME=votre_identifiant
CESAR_PASSWORD=votre_mot_de_passe

# Webhook Discord
# Créez un webhook dans Discord: Paramètres du serveur > Intégrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/VOTRE_WEBHOOK_ID/VOTRE_WEBHOOK_TOKEN

# Rôle Discord à mentionner
# ID du rôle à ping dans Discord (clic droit sur le rôle > Copier l'ID)
DISCORD_ROLE_ID=1234567890123456789
