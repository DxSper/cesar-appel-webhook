# Configuration César
# Ces identifiants sont à remplacer par les vôtres
CESAR_USERNAME=votre_identifiant
CESAR_PASSWORD=votre_mot_de_passe

# Webhook Discord
# Créez un webhook dans Discord: Paramètres du serveur > Intégrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/VOTRE_WEBHOOK_ID/VOTRE_WEBHOOK_TOKEN

# Rôle Discord à mentionner
# ID du rôle à ping dans Discord (clic droit sur le rôle > Copier l'ID)
DISCORD_ROLE_ID=1234567890123456789

# === Horaires (optionnel, valeurs par défaut) ===
# Session matin
BOT_START_HOUR=9
BOT_START_MINUTE=13
BOT_END_HOUR=13
BOT_END_MINUTE=43

# Session après-midi
BOT_AFTERNOON_START_HOUR=13
BOT_AFTERNOON_START_MINUTE=43
BOT_AFTERNOON_END_HOUR=17
BOT_AFTERNOON_END_MINUTE=15

# Intervalle entre chaque vérification (secondes)
BOT_CHECK_INTERVAL=30

# Heure d'envoi du planning quotidien (mode daemon)
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0

# === Instagram (optionnel) ===
# Pour recevoir les notifs aussi sur Instagram DM
# Le thread ID se trouve dans l'URL du DM: .../direct/t/XXXXXXXXX/
INSTAGRAM_USERNAME=votre_username
INSTAGRAM_PASSWORD=votre_mot_de_passe
INSTAGRAM_THREAD_ID=1234567890123456
