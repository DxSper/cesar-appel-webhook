[Unit]
Description=César Attendance Call Bot
After=network.target

[Service]
Type=simple
# Remplacez USERNAME par votre nom d'utilisateur
User=USERNAME
# Remplacez /home/USERNAME/cesar-appel-webhook par le chemin où vous avez cloné le repo
WorkingDirectory=/home/USERNAME/cesar-appel-webhook
ExecStart=/home/USERNAME/cesar-appel-webhook/run_bot.sh
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
